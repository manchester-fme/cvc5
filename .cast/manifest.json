{
  "coverage": {
    "repo_url": "https://github.com/cvc5/cvc5.git",
    "extra_repos": [],
    "pre_discovery_setup": "./configure.sh production --auto-download",
    "discovery_flag": "--build-dir",
    "discovery_target": "{solver}/build",
    "oracle_solver": null,
    "oracle_fetch": null
  },
  "fuzzer": {
    "repo_url": "https://github.com/cvc5/cvc5.git",
    "extra_repos": [],
    "extra_pip_packages": [],
    "tests_root": "test/regress/cli",
    "target_flag": "--cvc5-path",
    "target_binary_path": "./build/bin/cvc5",
    "oracle_solver": "z3",
    "oracle_flag": "--z3-path",
    "oracle_fetch_fallback": {
      "type": "pip",
      "package": "z3-solver"
    },
    "skip_sut_clone_if_binary_cached": false,
    "git_cleanup_dirs": ["cvc5", "yinyang"],
    "namespace_prefix": "cvc5::",
    "clang_args": [
      "-x", "c++",
      "-std=c++17",
      "-gz=none",
      "-I./include",
      "-I./build/include",
      "-I./src/include",
      "-I./src/.",
      "-I./build/src",
      "-isystem", "./build/deps/include",
      "-DCVC5_ASSERTIONS",
      "-DCVC5_DEBUG",
      "-DCVC5_STATISTICS_ON",
      "-DCVC5_TRACING",
      "-DCVC5_USE_POLY",
      "-D__BUILDING_CVC5LIB",
      "-Dcvc5_obj_EXPORTS",
      "-Wall",
      "-Wsuggest-override",
      "-Wnon-virtual-dtor",
      "-Wimplicit-fallthrough",
      "-Wshadow",
      "-fno-operator-names",
      "-Wno-deprecated-declarations",
      "-Wno-error=deprecated-declarations",
      "-fPIC",
      "-fvisibility=default",
      "-fparse-all-comments",
      "-Wno-unknown-pragmas",
      "-Wno-unused-parameter",
      "-Wno-unused-variable",
      "-Wno-unused-function"
    ]
  }
}
